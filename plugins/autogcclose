// ====================================================
// 🔒 AUTO GROUP LOCK/UNLOCK — v2 (rename fix)
// instagram.com/noureddine_ouafy
// Commands: .auto on | .auto off | .auto set HH:MM HH:MM | .auto status | .auto fix
//
// v2 fixes "the group opens but the name stays (❌ مغلق)":
//  1) The stored base name is CLEANED of any (❌ مغلق)/(✅ مفتوح) suffix
//     every time it is read — an old record that captured the name while
//     the group was already renamed heals itself, so opening can never
//     "restore" a name that still carries the closed suffix.
//  2) Open and close are now symmetric: close → "name (❌ مغلق)",
//     open → "name (✅ مفتوح)".
//  3) Every step (setting / rename) has its own try/catch, the rename is
//     VERIFIED by re-reading the group and retried once, and a per-minute
//     repair pass fixes a drifted name on its own.
//  4) .auto fix re-applies the current state (setting + name) right now.
// ====================================================

import fs from 'fs'
import moment from 'moment-timezone'
import schedule from 'node-schedule'

const dbFile   = './autoGC.json'
const timeZone = 'Africa/Casablanca'

global.autoGC = global.autoGC || {}
if (fs.existsSync(dbFile)) {
  try { global.autoGC = JSON.parse(fs.readFileSync(dbFile)) }
  catch { global.autoGC = {} }
} else {
  fs.writeFileSync(dbFile, JSON.stringify({}, null, 2))
}

const saveDB = () => {
  try { fs.writeFileSync(dbFile, JSON.stringify(global.autoGC, null, 2)); return true }
  catch (e) { console.error('[AutoGC] خطأ حفظ DB:', e); return false }
}

// ─── تنظيف الاسم الأساسي من أي لاحقة حالة ─────────────
const SUFFIX_RE = /\s*\(\s*(❌\s*مغلق|✅\s*مفتوح)\s*\)\s*$/
const cleanName = (name) => {
  let n = String(name || '').trim()
  while (SUFFIX_RE.test(n)) n = n.replace(SUFFIX_RE, '').trim()
  return n || 'Group'
}
const nameFor = (base, status) => status === 'closed' ? `${base} (❌ مغلق)` : `${base} (✅ مفتوح)`

const timeAfterMinutes = (timeStr, n) => {
  const [h, m] = timeStr.split(':').map(Number)
  const total  = h * 60 + m - n
  const hh     = Math.floor(((total % 1440) + 1440) % 1440 / 60)
  const mm     = ((total % 1440) + 1440) % 1440 % 60
  return `${String(hh).padStart(2,'0')}:${String(mm).padStart(2,'0')}`
}

const sleep = (ms) => new Promise((r) => setTimeout(r, ms))

// ─── تطبيق حالة (إعدادات + اسم) مع تحقق وإعادة محاولة ──
async function applyState(conn, chatId, gc, target) {
  const base = cleanName(gc.originalName)
  gc.originalName = base
  const wantName = nameFor(base, target)
  let settingOk = false, nameOk = false

  try {
    await conn.groupSettingUpdate(chatId, target === 'closed' ? 'announcement' : 'not_announcement')
    settingOk = true
  } catch (e) { console.error(`[AutoGC] setting ${target} ${chatId}:`, e?.message || e) }

  for (let attempt = 0; attempt < 2 && !nameOk; attempt++) {
    try {
      await conn.groupUpdateSubject(chatId, wantName)
      const md = await conn.groupMetadata(chatId).catch(() => null)
      nameOk = !md?.subject || md.subject === wantName
      if (!nameOk && attempt === 0) await sleep(3000)
    } catch (e) {
      console.error(`[AutoGC] rename ${target} ${chatId} (try ${attempt + 1}):`, e?.message || e)
      if (attempt === 0) await sleep(3000)
    }
  }
  return { settingOk, nameOk, wantName }
}

// ─── فحص المجموعات كل دقيقة ──────────────────────────
const checkGroupsStatus = async () => {
  const conn = global.conn
  if (!conn) return

  const now = moment().tz(timeZone).format('HH:mm')

  for (const chatId in global.autoGC) {
    const gc = global.autoGC[chatId]
    if (!gc?.enabled) continue

    // شفاء ذاتي: نظّف الاسم المخزّن إلا كان ملوثاً بلاحقة
    const cleaned = cleanName(gc.originalName)
    if (cleaned !== gc.originalName) { gc.originalName = cleaned; saveDB() }

    const { closeTime, openTime, originalName, status } = gc

    if (now === timeAfterMinutes(closeTime, 2) && gc.notifiedClose !== now) {
      gc.notifiedClose = now
      saveDB()
      await conn.sendMessage(chatId, {
        text: `⚠️ *تنبيه!*\n\nبعد *دقيقتين* سيتم *إغلاق المجموعة* 🔒\nموعد الإغلاق: *${closeTime}*\n\n_Powered by Silana AI_ 🤖`
      }).catch(console.error)
    }

    if (now === timeAfterMinutes(openTime, 2) && gc.notifiedOpen !== now) {
      gc.notifiedOpen = now
      saveDB()
      await conn.sendMessage(chatId, {
        text: `⚠️ *تنبيه!*\n\nبعد *دقيقتين* سيتم *فتح المجموعة* ✅\nموعد الفتح: *${openTime}*\n\n_Powered by Silana AI_ 🤖`
      }).catch(console.error)
    }

    // ── إغلاق ──
    if (now === closeTime && status !== 'closed') {
      const r = await applyState(conn, chatId, gc, 'closed')
      if (r.settingOk) {
        gc.status = 'closed'
        saveDB()
        await conn.sendMessage(chatId, {
          text: `🔒 *تم إغلاق المجموعة*\n\nالوقت: *${now}*\n💤 سيتم إعادة فتحها في *${openTime}*` + (r.nameOk ? '' : '\n⚠️ تعذّر تحديث اسم المجموعة — تأكد أن البوت مشرف.') + `\n\n_Powered by Silana AI_ 🤖`
        }).catch(console.error)
        console.log(`[AutoGC] 🔒 أُغلقت: ${chatId} (name ${r.nameOk ? 'ok' : 'FAILED'})`)
      }
      continue
    }

    // ── فتح ──
    if (now === openTime && status !== 'opened') {
      const r = await applyState(conn, chatId, gc, 'opened')
      if (r.settingOk) {
        gc.status = 'opened'
        saveDB()
        await conn.sendMessage(chatId, {
          text: `✅ *تم فتح المجموعة*\n\nالوقت: *${now}*\n💬 يمكنكم المشاركة الآن\n🔒 وقت الإغلاق القادم: *${closeTime}*` + (r.nameOk ? '' : '\n⚠️ تعذّر تحديث اسم المجموعة — تأكد أن البوت مشرف.') + `\n\n_Powered by Silana AI_ 🤖`
        }).catch(console.error)
        console.log(`[AutoGC] ✅ فُتحت: ${chatId} (name ${r.nameOk ? 'ok' : 'FAILED'})`)
      }
      continue
    }

    // ── إصلاح انحراف الاسم (الاسم لا يطابق الحالة المسجلة) ──
    if (status === 'closed' || status === 'opened') {
      if (!gc.lastRepair || Date.now() - gc.lastRepair > 3600000) {
        const md = conn.chats?.[chatId]?.metadata || await conn.groupMetadata(chatId).catch(() => null)
        const want = nameFor(originalName, status)
        if (md?.subject && md.subject !== want) {
          gc.lastRepair = Date.now()
          saveDB()
          try {
            await conn.groupUpdateSubject(chatId, want)
            console.log(`[AutoGC] 🛠️ أُصلح اسم ${chatId} → ${want}`)
          } catch (e) { console.error(`[AutoGC] repair rename ${chatId}:`, e?.message || e) }
        }
      }
    }
  }
}

if (!global.autoGCSchedule) {
  global.autoGCSchedule = schedule.scheduleJob('* * * * *', () => {
    checkGroupsStatus().catch(console.error)
  })
  console.log('[AutoGC] ✅ Scheduler شغال — كل دقيقة')
}

// ─── الأوامر ──────────────────────────────────────────
const handler = async (m, { conn, args }) => {
  if (!m.isGroup) return m.reply('❌ هذا الأمر للمجموعات فقط!')

  const chatId        = m.chat
  const groupMetadata = conn.chats[chatId]?.metadata || await conn.groupMetadata(chatId)
  const sub           = args[0]?.toLowerCase()

  if (sub === 'on') {
    global.autoGC[chatId] = {
      enabled:      true,
      closeTime:    global.autoGC[chatId]?.closeTime || '22:00',
      openTime:     global.autoGC[chatId]?.openTime  || '10:00',
      originalName: cleanName(groupMetadata.subject),
      status:       global.autoGC[chatId]?.status || 'opened'
    }
    return saveDB()
      ? m.reply(
          `✅ *تم تفعيل الإغلاق/الفتح التلقائي*\n\n` +
          `🔴 الإغلاق: *${global.autoGC[chatId].closeTime}*\n` +
          `🟢 الفتح:   *${global.autoGC[chatId].openTime}*\n\n` +
          `لتغيير الأوقات: *.auto set HH:MM HH:MM*\n_(الأول إغلاق، الثاني فتح)_`
        )
      : m.reply('❌ فشل في حفظ الإعدادات.')
  }

  if (sub === 'off') {
    if (!global.autoGC[chatId]?.enabled) return m.reply('⚠️ الميزة معطلة بالفعل.')
    delete global.autoGC[chatId]
    return saveDB() ? m.reply('❌ تم *إلغاء* الإغلاق/الفتح التلقائي.') : m.reply('❌ فشل في الحفظ.')
  }

  if (sub === 'set') {
    if (!args[1] || !args[2])
      return m.reply('⚠️ مثال: *.auto set 22:00 10:00*\n_(الأول إغلاق، الثاني فتح)_')
    if (!/^([01]\d|2[0-3]):([0-5]\d)$/.test(args[1]) || !/^([01]\d|2[0-3]):([0-5]\d)$/.test(args[2]))
      return m.reply('⚠️ صيغة خاطئة! استخدم HH:MM بنظام 24 ساعة.')

    if (!global.autoGC[chatId]) global.autoGC[chatId] = { originalName: cleanName(groupMetadata.subject), status: 'opened' }
    else global.autoGC[chatId].originalName = cleanName(global.autoGC[chatId].originalName || groupMetadata.subject)
    global.autoGC[chatId].enabled   = true
    global.autoGC[chatId].closeTime = args[1]
    global.autoGC[chatId].openTime  = args[2]

    return saveDB()
      ? m.reply(`✅ *تم تحديث الأوقات*\n\n🔴 الإغلاق: *${args[1]}*\n🟢 الفتح:   *${args[2]}*`)
      : m.reply('❌ فشل في الحفظ.')
  }

  // .auto fix — إعادة تطبيق الحالة الحالية (إعدادات + اسم) الآن
  if (sub === 'fix') {
    const gc = global.autoGC[chatId]
    if (!gc?.enabled) return m.reply('⚠️ الميزة غير مفعلة في هذه المجموعة.')
    const target = gc.status === 'closed' ? 'closed' : 'opened'
    const r = await applyState(conn, chatId, gc, target)
    saveDB()
    return m.reply(
      `🛠️ *إصلاح الحالة*\n\n` +
      `الإعدادات: ${r.settingOk ? '✅' : '❌'}\n` +
      `الاسم الآن: *${r.wantName}* ${r.nameOk ? '✅' : '❌ (تأكد أن البوت مشرف)'}`
    )
  }

  if (sub === 'status') {
    if (!global.autoGC[chatId]) return m.reply('⚠️ الميزة غير مفعلة في هذه المجموعة.')
    const { enabled, closeTime, openTime, status } = global.autoGC[chatId]
    return m.reply(
      `📊 *حالة التحكم التلقائي*\n\n` +
      `الحالة:    ${enabled ? '✅ مفعل' : '❌ معطل'}\n` +
      `المجموعة: ${status === 'closed' ? '🔒 مغلقة' : '🔓 مفتوحة'}\n` +
      `الاسم الأساسي: *${cleanName(global.autoGC[chatId].originalName)}*\n` +
      `🔴 الإغلاق: *${closeTime}*\n` +
      `🟢 الفتح:   *${openTime}*\n\n` +
      `_التوقيت: ${timeZone}_`
    )
  }

  return m.reply(
    `📋 *أوامر التحكم التلقائي*\n\n` +
    `*.auto on* — تفعيل\n` +
    `*.auto off* — إلغاء\n` +
    `*.auto set 22:00 10:00* — تعيين أوقات\n` +
    `*.auto status* — عرض الحالة\n` +
    `*.auto fix* — إصلاح الاسم والحالة الآن`
  )
}

handler.command  = ['auto']
handler.owner    = true
handler.botAdmin = true
handler.admin    = true

export default handler
